---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Título de la página; se completa con el nombre del sitio salvo en la portada */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const SITE = "Pon el foco";
const fullTitle = title ? `${title} · ${SITE}` : `${SITE} · Accesibilidad web y WCAG en español`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Atkinson+Hyperlegible+Mono:wght@400;600&family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap"
    />
    <script is:inline>
      // Aplica el tamaño de texto guardado antes de pintar, para evitar saltos
      try {
        const v = Number(localStorage.getItem("ac-size"));
        if (v) document.documentElement.style.setProperty("--root-size", v + "%");
        // Y el modo claro u oscuro elegido con el botón de la cabecera
        const t = localStorage.getItem("ac-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="absolute -top-24 left-4 z-[100] rounded-md bg-mark px-4 py-2.5 font-bold text-mark-ink focus:top-[calc(env(safe-area-inset-top,0px)+8px)]"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
