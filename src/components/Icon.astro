---
/** Iconos del sitio: un solo trazo redondeado. Siempre decorativos; el texto de al lado da el significado. */
interface Props {
  name: "check" | "cross" | "plus" | "arrow-left" | "arrow-right" | "transbordo";
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  check: "M4.5 11.5l4.2 4.2L17.5 6.5",
  cross: "M6 6l10 10M16 6L6 16",
  plus: "M11 4v14M4 11h14",
  "arrow-left": "M18 11H5M10 5l-6 6 6 6",
  "arrow-right": "M4 11h13M12 5l6 6-6 6",
  transbordo: "",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 22 22"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["flex-none", cls]}
>
  {
    name === "transbordo" ? (
      <>
        <circle cx="11" cy="11" r="8" stroke-width="2.4" />
        <circle cx="11" cy="11" r="3.2" fill="currentColor" stroke="none" />
      </>
    ) : (
      <path d={paths[name]} />
    )
  }
</svg>
