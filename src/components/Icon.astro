---
/** Iconos del sitio: un solo trazo redondeado. Siempre decorativos; el texto de al lado da el significado. */
interface Props {
  name: "check" | "cross" | "plus" | "arrow-left" | "arrow-right" | "desarrollo" | "diseno" | "contenidos" | "negocio";
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  check: "M4.5 11.5l4.2 4.2L17.5 6.5",
  cross: "M6 6l10 10M16 6L6 16",
  plus: "M11 4v14M4 11h14",
  "arrow-left": "M18 11H5M10 5l-6 6 6 6",
  "arrow-right": "M4 11h13M12 5l6 6-6 6",
  // Etiquetas de código </>
  desarrollo: "M7 6l-5 5 5 5M15 6l5 5-5 5M12.5 4l-3 14",
  // Lápiz
  diseno: "M4 18l1-4.5L14.5 4 18 7.5 8.5 17 4 18zM12 6.5l3.5 3.5",
  // Hoja con la esquina doblada y líneas de texto
  contenidos: "M5 3h9l4 4v12H5zM14 3v4h4M8 11h7M8 14.5h5",
  // Maletín
  negocio: "M3 8h16v10H3zM8 8V5h6v3M3 12.5h16",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 22 22"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["flex-none", cls]}
>
  <path d={paths[name]} />
</svg>
