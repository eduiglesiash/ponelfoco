---
import CodeExample from "./CodeExample.astro";
import Icon from "./Icon.astro";
import { CRITERIOS, slug } from "../data/criterios";
import type { Componente } from "../data/componentes";

interface Props {
  c: Componente;
  /** nativo: «Lo que te da el navegador» · medida: «Lo que tienes que añadir» */
  kind: "nativo" | "medida";
}

const { c, kind } = Astro.props;
const demo = c.demo === "same" ? c.codigo[0].code : c.demo;
const nombre = (id: string) => CRITERIOS.find((x) => x.id === id)?.nombre ?? "";
---

<article id={c.id} aria-labelledby={`t-${c.id}`} class="flex min-w-0 scroll-mt-24 flex-col gap-5 border-t-2 border-ink pt-5">
  <header class="flex flex-col gap-1.5">
    <h3 id={`t-${c.id}`} class="flex flex-wrap items-center gap-x-3 gap-y-1 text-subtitle">
      {c.nombre}
      <code class="rounded bg-sunk px-2 py-0.5 font-mono text-[.9rem] font-normal tracking-normal text-muted">{c.elemento}</code>
    </h3>
    <p class="max-w-[46rem]">{c.intro}</p>
  </header>

  <div class="grid gap-5 min-[861px]:grid-cols-2">
    <div>
      <h4 class="mb-2 font-bold">{kind === "nativo" ? "Lo que te da el navegador" : "Lo que tienes que añadir"}</h4>
      <ul class="flex flex-col gap-1.5">
        {
          c.claves.map((k) => (
            <li class="flex gap-2">
              <Icon name={kind === "nativo" ? "check" : "plus"} class:list={["mt-1", kind === "nativo" ? "text-ok" : "text-accent"]} />
              <span>{k}</span>
            </li>
          ))
        }
      </ul>
    </div>
    {
      c.teclado && (
        <div class="min-w-0">
          <table class="w-full border-collapse text-[.95rem]">
            <caption class="mb-2 text-left font-bold">Uso con teclado</caption>
            <thead class="sr-only">
              <tr>
                <th scope="col">Tecla</th>
                <th scope="col">Qué hace</th>
              </tr>
            </thead>
            <tbody>
              {c.teclado.map(([k, v]) => (
                <tr>
                  <th scope="row" class="border-b border-line py-1.5 pr-3 text-left align-top font-mono font-semibold whitespace-nowrap">
                    {k}
                  </th>
                  <td class="border-b border-line py-1.5">{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  {
    demo && (
      <div class="rounded-md border-2 border-dashed border-edge p-4">
        <p class="mb-3 font-bold">Pruébalo con el teclado</p>
        <div class="demo flex flex-col items-start gap-2" set:html={demo} />
      </div>
    )
  }

  <div class="flex flex-col gap-3">
    {c.codigo.map((k) => <CodeExample code={k.code} lang={k.lang} label={k.label} />)}
  </div>

  {c.nota && <p class="rounded-md bg-accent-soft px-4 py-3"><b>Ojo:</b> {c.nota}</p>}

  <p class="text-[.93rem] text-muted">
    <b>Criterios relacionados:</b>{" "}
    {
      c.criterios.map((id, i) => (
        <>
          {i > 0 && " · "}
          <a href={`/criterios/${slug(id)}/`}>
            {id} {nombre(id)}
          </a>
        </>
      ))
    }
    {
      c.apg && (
        <>
          {" · "}
          <a href={c.apg} target="_blank" rel="noopener" hreflang="en">
            Patrón en la guía del W3C (en inglés)
          </a>
        </>
      )
    }
  </p>
</article>
