---
import Figura from "./Figura.astro";
import { CRITERIOS, PRINCIPIOS, PRINCIPIOS_TEXTO, obsoleto } from "../data/criterios";

const facts = [
  {
    value: "28/06/2025",
    text: "Fecha desde la que la Ley 11/2023 obliga a muchas empresas privadas.",
    source: { label: "BOE", href: "https://www.boe.es/buscar/act.php?id=BOE-A-2023-11022" },
  },
  {
    value: "WCAG 2.2 · AA",
    text: "Nivel de referencia en la nueva norma EN 301 549 v4.1.1.",
    source: {
      label: "ETSI, PDF en inglés",
      href: "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/04.01.01_60/en_301549v040101p.pdf",
    },
  },
  {
    value: "55 criterios",
    text: "Son los de nivel A y AA que hay que cumplir.",
    source: { label: "W3C, en inglés", href: "https://www.w3.org/TR/WCAG22/" },
  },
  {
    value: "Hasta 1.000.000 €",
    text: "Multa máxima del régimen general de sanciones.",
    source: { label: "BOE", href: "https://www.boe.es/buscar/act.php?id=BOE-A-2013-12632" },
  },
];

const principios = Object.entries(PRINCIPIOS).map(([n, name]) => ({
  n,
  name,
  text: PRINCIPIOS_TEXTO[n],
  total: CRITERIOS.filter((c) => c.id[0] === n && !obsoleto(c.id)).length,
}));
---

<section aria-labelledby="t-hero" class="wrap pt-[clamp(2.5rem,6vw,5rem)] pb-10">
  <div class="grid items-center gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
    <div>
      <h1 id="t-hero" class="max-w-[16ch] text-[clamp(2.6rem,1.4rem+4.6vw,5rem)] leading-[0.98] tracking-[-0.04em]">
        La accesibilidad web <mark class="pincel px-[.12em]">ya es obligatoria.</mark> Aquí aprendes a
        cumplirla.
      </h1>
      <p class="mt-6 max-w-160 text-[1.2rem] text-muted">
        Qué exige la ley, si te afecta y cómo llevarlo al código. En castellano claro, con ejemplos que puedes copiar y
        pensado para quien diseña, programa o dirige un proyecto digital.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/me-afecta/">Comprobar si me afecta</a>
        <a class="btn btn-ghost" href="/criterios/">Ver los criterios con código</a>
      </div>
    </div>

    <nav aria-labelledby="t-principios">
      <h2 id="t-principios" class="text-title">Cuatro principios para todo WCAG</h2>
      <p class="mt-1 text-muted">Todo WCAG cabe en cuatro principios. Elige uno para ver sus criterios.</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6">
        {
          principios.map((p, i) => (
            <li>
              <a
                href={`/criterios/?p=${p.n}`}
                class:list={[`principio-${p.n}`, "figura-salta group flex flex-col items-start gap-2 rounded-2xl p-2 text-ink no-underline"]}
              >
                <Figura n={p.n} delay={i * 220} class="h-[clamp(5.5rem,4rem+5vw,8rem)] w-auto" />
                <span class="text-subtitle font-display font-extrabold leading-tight group-hover:underline group-hover:decoration-[3px] group-hover:decoration-(--c)">
                  {p.name}
                </span>
                <span class="text-caption font-bold text-muted">{p.total} criterios</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="revela mt-14 border-t border-line">
    <dl class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))] gap-x-8">
      {
        facts.map((f) => (
          <div class="flex flex-col gap-1 border-b border-line py-4">
            <dt class="font-mono text-lead font-semibold">{f.value}</dt>
            <dd class="text-[.95rem] text-muted">
              {f.text}{" "}
              <a href={f.source.href} target="_blank" rel="noopener" class="whitespace-nowrap font-semibold">
                Fuente: {f.source.label}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="pt-3 text-[.9rem] text-muted">España y Unión Europea. Datos revisados en octubre de 2026.</p>
  </div>
</section>
