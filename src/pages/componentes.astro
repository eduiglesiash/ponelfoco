---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import SectionHead from "../components/SectionHead.astro";
import ComponentEntry from "../components/ComponentEntry.astro";
import { NATIVOS, A_MEDIDA } from "../data/componentes";
---

<Layout
  title="Componentes accesibles"
  description="Elementos HTML que ya son accesibles sin hacer nada y cómo hacer accesibles los componentes a medida: pestañas, interruptores, carruseles o autocompletar."
>
  <PageHead title="Componentes accesibles, con código">
    Muchos elementos de HTML ya son accesibles de serie: solo hay que usarlos. Cuando el diseño pide algo que no existe en
    HTML, aquí tienes cómo construirlo para que cumpla.
  </PageHead>

  <div class="wrap">
    <div class="mb-12 grid items-start gap-x-10 gap-y-8 min-[861px]:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div class="rounded-xl bg-sign p-[clamp(1.25rem,3vw,2rem)] text-sign-ink">
        <h2 class="mb-2 text-[clamp(1.6rem,1.2rem+1.8vw,2.25rem)]">La regla de oro</h2>
        <p>
          Si existe un elemento HTML que hace lo que necesitas, úsalo. Un <code>button</code> trae de serie el foco, el
          teclado, el rol y los estados. Con un <code>div</code> tienes que programarlo todo, y es fácil que falte algo.
          ARIA cambia lo que se anuncia, pero no añade comportamiento.
        </p>
      </div>
      <nav aria-labelledby="t-indice" class="border-t-2 border-ink pt-4">
        <h2 id="t-indice" class="mb-2 text-subtitle">En esta página</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,11rem),1fr))] gap-x-6 gap-y-3">
          <div>
            <p class="font-semibold"><a href="#nativos">Nativos</a></p>
            <ul class="mt-1 flex flex-col text-[.95rem]">
              {NATIVOS.map((c) => <li><a href={`#${c.id}`} class="inline-flex min-h-8 items-center">{c.nombre}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="font-semibold"><a href="#a-medida">A medida</a></p>
            <ul class="mt-1 flex flex-col text-[.95rem]">
              {A_MEDIDA.map((c) => <li><a href={`#${c.id}`} class="inline-flex min-h-8 items-center">{c.nombre}</a></li>)}
            </ul>
          </div>
        </div>
      </nav>
    </div>

    <section id="nativos" aria-labelledby="t-nativos" class="border-t border-line py-[clamp(2rem,4vw,3rem)]">
      <SectionHead title="Componentes nativos de HTML" id="t-nativos">
        Elementos que el navegador ya hace accesibles. Lo único que tienes que poner tú es un buen texto: etiquetas,
        nombres y alternativas.
      </SectionHead>
      <div class="flex flex-col gap-14">
        {NATIVOS.map((c) => <ComponentEntry c={c} kind="nativo" />)}
      </div>
    </section>

    <section id="a-medida" aria-labelledby="t-medida" class="border-t border-line py-[clamp(2rem,4vw,3rem)]">
      <SectionHead title="Componentes a medida" id="t-medida">
        Patrones de diseño que HTML no trae. Para que cumplan WCAG necesitan roles y estados ARIA, manejo de teclado y foco
        visible. Siguen la guía de prácticas de ARIA del W3C.
      </SectionHead>
      <div class="flex flex-col gap-14">
        {A_MEDIDA.map((c) => <ComponentEntry c={c} kind="medida" />)}
      </div>
    </section>
  </div>
</Layout>

<script>
  // Los mismos scripts cuyo código se muestra en la página
  import "../scripts/interruptor.js";
  import "../scripts/pestanas.js";

  // Demo del botón: escribe el mensaje en la región role="status" de su demo
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-demo-msg]")) {
    b.addEventListener("click", () => {
      const status = b.closest(".demo")!.querySelector('[role="status"]')!;
      status.textContent = b.dataset.demoMsg!;
    });
  }

  // Demo de la ventana modal
  const dialogo = document.getElementById("demo-dialogo") as HTMLDialogElement;
  document.getElementById("demo-abrir")!.addEventListener("click", () => dialogo.showModal());
</script>
