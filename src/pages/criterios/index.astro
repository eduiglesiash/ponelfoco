---
import Layout from "../../layouts/Layout.astro";
import Figura from "../../components/Figura.astro";
import LevelBadge from "../../components/LevelBadge.astro";
import Areas from "../../components/Areas.astro";
import FiltroAreas from "../../components/FiltroAreas.astro";
import { AREAS, areas } from "../../data/areas";
import { CRITERIOS, PAUTAS, PRINCIPIOS, PRINCIPIOS_TEXTO, obsoleto, pauta, slug } from "../../data/criterios";

/** Texto normalizado (minúsculas, sin tildes) para el buscador */
const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

const principios = Object.entries(PRINCIPIOS).map(([n, name]) => ({
  n,
  name,
  text: PRINCIPIOS_TEXTO[n],
  total: CRITERIOS.filter((c) => c.id[0] === n && !obsoleto(c.id)).length,
  pautas: Object.keys(PAUTAS)
    .filter((p) => p[0] === n)
    .map((p) => ({ id: p, items: CRITERIOS.filter((c) => pauta(c.id) === p) })),
}));
const exigidos = CRITERIOS.filter((c) => c.nivel !== "AAA" && !obsoleto(c.id)).length;
---

<Layout
  title="Criterios WCAG 2.2"
  description="Los criterios WCAG 2.2 explicados en castellano, con casos de uso y ejemplos de código para cumplirlos."
>
  <div class="wrap-wide pt-[clamp(2rem,5vw,3.5rem)] pb-6">
    <h1 class="max-w-[18ch] text-[clamp(2.4rem,1.4rem+3.8vw,4.25rem)] tracking-[-0.035em]">
      Los criterios WCAG 2.2, <span class="pincel px-[.1em]">con código</span>
    </h1>
    <p class="mt-4 max-w-[44rem] text-lead text-muted">
      Cada criterio explicado en castellano claro: qué pide, a quién ayuda, un caso real y código correcto e incorrecto.
      La ley exige los {exigidos} de nivel A y AA; los AAA son recomendaciones.
    </p>
  </div>

  <div class="wrap-wide">
    <section aria-labelledby="t-buscar">
      <h2 id="t-buscar" class="sr-only">Buscar y filtrar criterios</h2>

      <div role="group" aria-labelledby="g-principio" class="mb-5">
        <p id="g-principio" class="mb-2 font-bold text-muted">Principio</p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
          <button type="button" class="filtro-p" data-p="0" aria-pressed="true">
            <span class="flex h-12 items-center gap-1" aria-hidden="true">
              {principios.map((p) => <span class:list={[`principio-${p.n}`, "h-8 w-2.5 rounded-full bg-(--c)"]} />)}
            </span>
            <span>Todos</span>
          </button>
          {
            principios.map((p) => (
              <button type="button" class:list={["filtro-p figura-salta", `principio-${p.n}`]} data-p={p.n} aria-pressed="false">
                <Figura n={p.n} class="h-12 w-auto" />
                <span class="min-w-0 hyphens-auto [overflow-wrap:anywhere]">
                  {p.name}
                  <span class="block text-caption font-normal">{p.total} criterios</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <FiltroAreas leyenda class="mb-5" />

      <div
        role="search"
        class="z-20 -mx-[clamp(16px,3vw,40px)] flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-line bg-bg/90 px-[clamp(16px,3vw,40px)] py-3 backdrop-blur-lg min-[701px]:sticky min-[701px]:top-[calc(env(safe-area-inset-top,0px)+4.25rem)]"
      >
        <div
          class="flex min-w-[min(100%,18rem)] flex-[1_1_22rem] items-center gap-2 rounded-full border-[1.5px] border-edge bg-surface px-4 transition-colors focus-within:border-ink focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-mark"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" class="flex-none">
            <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <label for="search" class="sr-only">Buscar criterio</label>
          <input
            id="search"
            name="q"
            type="search"
            autocomplete="off"
            aria-keyshortcuts="/"
            placeholder="Número, nombre o tema: contraste, formulario, vídeo…"
            class="min-h-11 min-w-0 flex-1 border-0 bg-transparent py-2.5 text-ink focus-visible:shadow-none focus-visible:outline-none"
          />
          <kbd
            aria-hidden="true"
            class="hidden rounded border border-line bg-sunk px-1.5 font-mono text-caption text-muted min-[701px]:inline">/</kbd
          >
        </div>
        <div role="group" aria-labelledby="g-nivel" class="flex flex-wrap items-center gap-1.5">
          <span id="g-nivel" class="mr-1 text-[.9rem] font-bold text-muted">Nivel</span>
          <button type="button" class="toggle" data-lv="A" aria-pressed="true">A</button>
          <button type="button" class="toggle" data-lv="AA" aria-pressed="true">AA</button>
          <button type="button" class="toggle" data-lv="AAA" aria-pressed="false">AAA</button>
        </div>
        <button type="button" class="toggle" id="onlyNew" aria-pressed="false">Solo nuevos en 2.2</button>
        <p id="count" aria-live="polite" class="text-[.95rem] font-bold text-muted md:ml-auto"></p>
      </div>

      <p id="empty" hidden class="mt-8 rounded-xl border border-dashed border-edge p-8 text-center text-muted">
        No hay criterios con esos filtros. Prueba a quitar alguno o buscar otra palabra.
      </p>

      {
        principios.map((p) => (
          <section
            id={`principio-${p.n}`}
            aria-labelledby={`t-p-${p.n}`}
            data-principio={p.n}
            class:list={[`principio-${p.n}`, "revela mt-12 scroll-mt-40"]}
          >
            <div class="mb-6 flex items-end gap-4">
              <Figura n={p.n} class="h-16 w-auto flex-none sm:h-20" />
              <div class="min-w-0">
                <h2 id={`t-p-${p.n}`} class="text-[clamp(1.8rem,1.3rem+2vw,2.6rem)]">
                  <span class="sr-only">Principio {p.n}: </span>
                  {p.name}
                </h2>
                <p class="mt-1 text-muted">{p.text}</p>
              </div>
              <p class="ml-auto hidden flex-none font-mono text-caption font-semibold text-muted sm:block" data-p-count />
            </div>
            <div class="grid gap-x-10 gap-y-8 md:grid-cols-2 xl:grid-cols-3">
              {p.pautas.map((t) => (
                <div data-zone class="min-w-0">
                  <h3 class="mb-1 flex items-baseline gap-2 border-b-[3px] border-(--c) pb-1.5 text-title">
                    <span class="font-mono text-[.95rem] font-semibold text-(--c-text)">{t.id}</span>
                    {PAUTAS[t.id]}
                  </h3>
                  <ol>
                    {t.items.map((c) => (
                      <li
                        data-crit
                        data-lv={c.nivel}
                        data-new={c.nuevo ? "1" : undefined}
                        data-areas={areas(c.id).join(" ")}
                        data-obsoleto={obsoleto(c.id) ? "" : undefined}
                        data-q={norm([...Object.values(c), ...areas(c.id).map((a) => AREAS[a].nombre)].join(" "))}
                        hidden={c.nivel === "AAA"}
                        class="border-b border-line"
                      >
                        <a
                          href={`/criterios/${slug(c.id)}/`}
                          class="group flex min-h-12 items-start gap-3 rounded-lg px-1.5 py-2.5 text-ink no-underline transition-colors hover:bg-sunk"
                        >
                          <span
                            class="w-[3.3rem] flex-none pt-px font-mono text-[.95rem] font-semibold text-(--c-text)"
                            style={`view-transition-name: c-${slug(c.id)}`}
                          >
                            {c.id}
                          </span>
                          <span
                            class:list={[
                              "min-w-0 flex-1 leading-snug group-hover:underline group-hover:decoration-2",
                              obsoleto(c.id) && "text-muted",
                            ]}
                          >
                            {c.nombre}
                            {c.nuevo && <span class="badge-new ml-1.5 inline-block align-[.1em]">Nuevo</span>}
                            <span class="mt-1 block">
                              <Areas id={c.id} />
                            </span>
                          </span>
                          {obsoleto(c.id) ? <span class="lv lv-AAA">Eliminado</span> : <LevelBadge nivel={c.nivel} />}
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  @reference "../../styles/global.css";

  /* Botones de principio: figura y nombre; el pulsado se rellena con el color del principio.
     Si el nombre no cabe junto a la figura (columnas estrechas, texto ampliado), pasa debajo en vez de salirse */
  .filtro-p {
    @apply flex min-h-16 cursor-pointer flex-wrap items-center gap-x-3 gap-y-1 rounded-2xl border-[1.5px] border-edge bg-surface px-3 py-2 text-left font-display text-[1.05rem] font-extrabold text-ink transition-[background-color,border-color,scale] duration-200 hover:border-ink active:scale-[.98];
  }
  .filtro-p[aria-pressed="true"] {
    background: var(--c, var(--ink));
    border-color: var(--c, var(--ink));
    color: var(--c-ink, var(--bg));
  }
  /* En el botón pulsado la figura pasa al color del texto para no perderse sobre su propio color */
  .filtro-p[aria-pressed="true"]:not([data-p="0"]) :global(.figura) {
    --ink: currentColor;
    --c: currentColor;
  }
</style>

<script>
  import { coincide, leerAreas } from "../../scripts/filtro-areas.js";

  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const plural = (n: number) => n + (n === 1 ? " criterio" : " criterios");

  type State = { lv: Record<string, boolean>; p: string; onlyNew: boolean; q: string; areas: string[] };
  const state: State = { lv: { A: true, AA: true, AAA: false }, p: "0", onlyNew: false, q: "", areas: leerAreas() };
  try {
    const s = JSON.parse(localStorage.getItem("ac-filters") || "null");
    if (s && s.lv) Object.assign(state, { lv: s.lv, onlyNew: !!s.onlyNew });
  } catch {}

  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-principio]"));
  const pButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filtro-p"));
  const lvButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".toggle[data-lv]"));
  const areaButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".toggle[data-area]"));
  const onlyNew = document.getElementById("onlyNew")!;
  const count = document.getElementById("count")!;
  const empty = document.getElementById("empty")!;
  const search = document.getElementById("search") as HTMLInputElement;

  function render() {
    const q = norm(state.q.trim());
    let shown = 0;
    let closed = 0;
    for (const sec of sections) {
      let inSec = 0;
      let visibleInSec = 0;
      const pOk = state.p === "0" || sec.dataset.principio === state.p;
      for (const zone of sec.querySelectorAll<HTMLElement>("[data-zone]")) {
        let inZone = 0;
        for (const el of zone.querySelectorAll<HTMLElement>("[data-crit]")) {
          const d = el.dataset;
          const visible =
            pOk &&
            state.lv[d.lv!] &&
            coincide(state.areas, d.areas) &&
            (!state.onlyNew || d.new === "1") &&
            (!q || d.q!.includes(q));
          el.hidden = !visible;
          if (!visible) continue;
          inZone++;
          if (d.obsoleto === undefined) inSec++;
          else closed++;
        }
        zone.hidden = inZone === 0;
        visibleInSec += inZone;
      }
      sec.hidden = visibleInSec === 0;
      sec.querySelector<HTMLElement>("[data-p-count]")!.textContent = plural(inSec);
      shown += inSec;
    }
    empty.hidden = shown + closed > 0;
    count.textContent = plural(shown) + (closed ? ` · ${closed} eliminado` : "");
    pButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.p === state.p)));
    lvButtons.forEach((b) => b.setAttribute("aria-pressed", String(!!state.lv[b.dataset.lv!])));
    areaButtons.forEach((b) => b.setAttribute("aria-pressed", String(state.areas.includes(b.dataset.area!))));
    onlyNew.setAttribute("aria-pressed", String(state.onlyNew));
    try {
      localStorage.setItem("ac-filters", JSON.stringify({ lv: state.lv, onlyNew: state.onlyNew, areas: state.areas }));
    } catch {}
  }

  pButtons.forEach((b) =>
    b.addEventListener("click", () => {
      state.p = b.dataset.p!;
      render();
    }),
  );
  lvButtons.forEach((b) =>
    b.addEventListener("click", () => {
      state.lv[b.dataset.lv!] = !state.lv[b.dataset.lv!];
      render();
    }),
  );
  areaButtons.forEach((b) =>
    b.addEventListener("click", () => {
      const a = b.dataset.area!;
      state.areas = state.areas.includes(a) ? state.areas.filter((x) => x !== a) : [...state.areas, a];
      render();
    }),
  );
  onlyNew.addEventListener("click", () => {
    state.onlyNew = !state.onlyNew;
    render();
  });
  let timer: ReturnType<typeof setTimeout>;
  search.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = search.value;
      render();
    }, 120);
  });
  // «/» lleva al buscador, salvo si ya se está escribiendo en un campo
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || t.closest("input, textarea, select, [contenteditable]")) return;
    e.preventDefault();
    search.focus();
  });

  // Búsqueda o principio que llegan por la URL: /criterios/?q=… desde una ficha, /criterios/?p=2 desde la portada
  const params = new URLSearchParams(location.search);
  const initial = params.get("q");
  if (initial) {
    search.value = initial;
    state.q = initial;
  }
  if (["1", "2", "3", "4"].includes(params.get("p") ?? "")) state.p = params.get("p")!;
  render();

  // Enlaces antiguos de la página única: /criterios/#c-1-4-3 → /criterios/1-4-3/
  const m = location.hash.match(/^#c-(\d+-\d+-\d+)$/);
  if (m) location.replace(`/criterios/${m[1]}/`);
</script>
