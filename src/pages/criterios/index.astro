---
import Layout from "../../layouts/Layout.astro";
import LineaMetro from "../../components/LineaMetro.astro";
import { CRITERIOS, PRINCIPIOS, PRINCIPIOS_TEXTO, obsoleto } from "../../data/criterios";

const lineas = Object.entries(PRINCIPIOS).map(([n, name]) => ({
  n,
  name,
  text: PRINCIPIOS_TEXTO[n],
  total: CRITERIOS.filter((c) => c.id[0] === n && !obsoleto(c.id)).length,
}));
const exigidos = CRITERIOS.filter((c) => c.nivel !== "AAA" && !obsoleto(c.id)).length;
---

<Layout
  title="Criterios WCAG 2.2"
  description="Los criterios WCAG 2.2 explicados en castellano, con casos de uso y ejemplos de código para cumplirlos."
>
  <div class="wrap-wide grid gap-x-12 gap-y-6 pt-[clamp(2rem,5vw,3.5rem)] pb-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-end">
    <div>
      <h1 class="text-[clamp(2.2rem,1.4rem+3.6vw,4rem)]">Los criterios WCAG 2.2, con código</h1>
      <p class="mt-4 max-w-[40rem] text-[1.15rem] text-muted">
        Cada criterio explicado en castellano claro: qué pide, a quién ayuda, un caso real y código correcto e incorrecto.
        La ley exige los {exigidos} de nivel A y AA; los AAA son recomendaciones.
      </p>
    </div>
    <nav aria-labelledby="t-lineas">
      <h2 id="t-lineas" class="mb-2 text-label text-muted">Las cuatro líneas: un principio cada una</h2>
      <ul class="grid gap-2 min-[420px]:grid-cols-2">
        {
          lineas.map((l) => (
            <li>
              <a
                href={`#linea-${l.n}`}
                class:list={[
                  `linea-${l.n}`,
                  "flex min-h-11 items-center gap-2.5 rounded-md border border-edge bg-surface px-2.5 py-2 font-bold text-ink no-underline hover:border-ink",
                ]}
              >
                <span class="line-badge" aria-hidden="true">L{l.n}</span>
                <span class="flex-1">{l.name}</span>
                <span class="font-mono text-caption font-semibold text-muted">
                  {l.total}<span class="sr-only"> criterios</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap-wide">
    <section aria-labelledby="t-buscar">
      <h2 id="t-buscar" class="sr-only">Buscar un criterio</h2>
      <div
        role="search"
        class="z-20 -mx-[clamp(16px,3vw,40px)] flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-line bg-bg/95 px-[clamp(16px,3vw,40px)] py-3 backdrop-blur-md min-[701px]:sticky min-[701px]:top-[calc(env(safe-area-inset-top,0px)+4rem)]"
      >
        <div
          class="flex min-w-[min(100%,18rem)] flex-[1_1_22rem] items-center gap-2 rounded-md border-[1.5px] border-muted bg-surface px-3 focus-within:border-ink focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-mark"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" class="flex-none">
            <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <label for="search" class="sr-only">Buscar criterio</label>
          <input
            id="search"
            name="q"
            type="search"
            autocomplete="off"
            aria-keyshortcuts="/"
            placeholder="Número, nombre o tema: contraste, formulario, vídeo…"
            class="min-w-0 flex-1 border-0 bg-transparent py-2.5 text-ink focus-visible:shadow-none focus-visible:outline-none"
          />
          <kbd
            aria-hidden="true"
            class="hidden rounded border border-line bg-sunk px-1.5 font-mono text-caption text-muted min-[701px]:inline">/</kbd
          >
        </div>
        <div role="group" aria-labelledby="g-nivel" class="flex flex-wrap items-center gap-1.5">
          <span id="g-nivel" class="mr-1 text-[.9rem] font-bold text-muted">Nivel</span>
          <button type="button" class="toggle" data-lv="A" aria-pressed="true">A</button>
          <button type="button" class="toggle" data-lv="AA" aria-pressed="true">AA</button>
          <button type="button" class="toggle" data-lv="AAA" aria-pressed="false">AAA</button>
        </div>
        <button type="button" class="toggle" id="onlyNew" aria-pressed="false">Solo nuevos en 2.2</button>
        <p id="count" aria-live="polite" class="text-[.95rem] font-semibold text-muted md:ml-auto"></p>
      </div>

      <p id="empty" hidden class="mt-8 rounded-md border border-dashed border-line bg-surface p-8 text-center text-muted">
        No hay criterios con esos filtros. Prueba a quitar alguno o buscar otra palabra.
      </p>

      <div class="mt-8 grid gap-x-10 gap-y-12 md:grid-cols-2 xl:grid-cols-3 wide:grid-cols-4 wide:gap-x-8">
        {
          [lineas.slice(0, 1), lineas.slice(1, 2), lineas.slice(2)].map((col) => (
            <div class="flex min-w-0 flex-col gap-12 wide:contents">
              {col.map((l) => (
                <section id={`linea-${l.n}`} aria-labelledby={`t-linea-${l.n}`} data-line class="min-w-0 scroll-mt-40">
                  <div class:list={[`linea-${l.n}`, "mb-4 border-t-[6px] border-(--c) pt-3"]}>
                    <h2 id={`t-linea-${l.n}`} class="flex items-center gap-3 text-[1.6rem]">
                      <span class="line-badge text-lead" aria-hidden="true">
                        L{l.n}
                      </span>
                      <span>
                        <span class="sr-only">Línea {l.n}: </span>
                        {l.name}
                      </span>
                    </h2>
                    <p class="mt-2 text-[.98rem] text-muted">{l.text}</p>
                    <p class="mt-1 font-mono text-caption font-semibold text-muted" data-line-count data-total={l.total}></p>
                  </div>
                  <LineaMetro n={l.n} listado />
                  <p data-line-empty hidden class="ml-2 text-[.95rem] text-muted">
                    Ningún criterio de esta línea coincide.
                  </p>
                </section>
              ))}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<script>
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const plural = (n: number) => n + (n === 1 ? " criterio" : " criterios");
  const ofTotal = (n: number, total: number) => (n === total ? plural(n) : `${n} de ${plural(total)}`);

  type State = { lv: Record<string, boolean>; onlyNew: boolean; q: string };
  const state: State = { lv: { A: true, AA: true, AAA: false }, onlyNew: false, q: "" };
  try {
    const s = JSON.parse(localStorage.getItem("ac-filters") || "null");
    if (s && s.lv) Object.assign(state, { lv: s.lv, onlyNew: !!s.onlyNew });
  } catch {}

  const lines = Array.from(document.querySelectorAll<HTMLElement>("[data-line]"));
  const lvButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".toggle[data-lv]"));
  const onlyNew = document.getElementById("onlyNew")!;
  const count = document.getElementById("count")!;
  const empty = document.getElementById("empty")!;
  const search = document.getElementById("search") as HTMLInputElement;

  function render() {
    const q = norm(state.q.trim());
    let shown = 0;
    let closed = 0;
    for (const line of lines) {
      let inLine = 0;
      let lineShown = 0;
      for (const zone of line.querySelectorAll<HTMLElement>("[data-zone]")) {
        let inZone = 0;
        let shownInZone = 0;
        for (const el of zone.querySelectorAll<HTMLElement>("[data-crit]")) {
          const d = el.dataset;
          const visible = state.lv[d.lv!] && (!state.onlyNew || d.new === "1") && (!q || d.q!.includes(q));
          el.hidden = !visible;
          if (visible && d.obsoleto === undefined) inZone++;
          if (visible && d.obsoleto !== undefined) closed++;
          if (visible) shownInZone++;
        }
        zone.hidden = shownInZone === 0;
        lineShown += shownInZone;
        inLine += inZone;
      }
      const lc = line.querySelector<HTMLElement>("[data-line-count]")!;
      lc.textContent = ofTotal(inLine, Number(lc.dataset.total));
      line.querySelector<HTMLElement>("[data-line-empty]")!.hidden = lineShown > 0;
      shown += inLine;
    }
    empty.hidden = shown + closed > 0;
    count.textContent = plural(shown) + (closed ? ` · ${closed} eliminado` : "");
    lvButtons.forEach((b) => b.setAttribute("aria-pressed", String(!!state.lv[b.dataset.lv!])));
    onlyNew.setAttribute("aria-pressed", String(state.onlyNew));
    try {
      localStorage.setItem("ac-filters", JSON.stringify({ lv: state.lv, onlyNew: state.onlyNew }));
    } catch {}
  }

  lvButtons.forEach((b) =>
    b.addEventListener("click", () => {
      state.lv[b.dataset.lv!] = !state.lv[b.dataset.lv!];
      render();
    }),
  );
  onlyNew.addEventListener("click", () => {
    state.onlyNew = !state.onlyNew;
    render();
  });
  let timer: ReturnType<typeof setTimeout>;
  search.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = search.value;
      render();
    }, 120);
  });
  // «/» lleva al buscador, salvo si ya se está escribiendo en un campo
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || t.closest("input, textarea, select, [contenteditable]")) return;
    e.preventDefault();
    search.focus();
  });
  // Búsqueda que llega desde el buscador de una ficha (/criterios/?q=…)
  const initial = new URLSearchParams(location.search).get("q");
  if (initial) {
    search.value = initial;
    state.q = initial;
  }
  render();

  // Enlaces antiguos de la página única: /criterios/#c-1-4-3 → /criterios/1-4-3/
  const m = location.hash.match(/^#c-(\d+-\d+-\d+)$/);
  if (m) location.replace(`/criterios/${m[1]}/`);
</script>
