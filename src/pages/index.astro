---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import CodeExample from "../components/CodeExample.astro";
import Icon from "../components/Icon.astro";

const secciones = [
  {
    href: "/me-afecta/",
    title: "¿Me afecta la ley?",
    text: "Tres preguntas sobre tu organización y una respuesta clara: qué normas te aplican y qué tienes que hacer.",
    cta: "Hacer la prueba",
  },
  {
    href: "/criterios/",
    title: "Criterios WCAG 2.2",
    text: "Los 55 criterios que exige la ley, explicados uno a uno con casos reales y código correcto e incorrecto.",
    cta: "Explorar los criterios",
  },
  {
    href: "/componentes/",
    title: "Componentes accesibles",
    text: "Lo que HTML ya te da hecho y cómo construir pestañas, interruptores o carruseles que cumplan, con demos para probar.",
    cta: "Ver los componentes",
  },
  {
    href: "/normativa/",
    title: "Normativa",
    text: "Leyes, plazos, sanciones, declaración de accesibilidad y los enlaces oficiales que necesita tu empresa.",
    cta: "Consultar la normativa",
  },
];

const perfiles = [
  {
    title: "Si programas",
    text: "Ejemplos de HTML, CSS y JavaScript para cada criterio y componentes listos para adaptar.",
  },
  {
    title: "Si diseñas",
    text: "Contraste, tamaños de objetivo, foco visible y estados: lo que hay que decidir antes de llegar al código.",
  },
  {
    title: "Si diriges o asesoras",
    text: "A quién obliga la ley, desde cuándo, qué sanciones hay y qué documentación tienes que tener.",
  },
];

const ejemplo = `
<!-- Un botón de verdad: foco, teclado y nombre accesible sin escribir nada más -->
<button type="button">Añadir al carrito</button>`;
---

<Layout description="Accesibilidad web y WCAG en español: la normativa de España y la UE y los criterios WCAG 2.2 explicados con ejemplos de código y componentes accesibles.">
  <Hero />

  <section aria-labelledby="t-que" class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
    <div class="wrap">
      <SectionHead title="Qué puedes hacer aquí" id="t-que">
        Cuatro secciones, según lo que necesites hoy.
      </SectionHead>
      <ul class="revela overflow-hidden rounded-[2rem_1.25rem_2.25rem_1.5rem] bg-sign text-sign-ink">
        {
          secciones.map((s, i) => (
            <li
              class:list={[
                "group relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 px-[clamp(1.25rem,3vw,2.5rem)] py-6 transition-colors hover:bg-sign-hover",
                i > 0 && "border-t border-sign-hover",
              ]}
            >
              <div class="min-w-0">
                <h3 class="text-[clamp(1.3rem,1.1rem+.8vw,1.6rem)]">
                  <a
                    href={s.href}
                    class="text-sign-ink no-underline group-hover:underline group-hover:decoration-2 after:absolute after:inset-0"
                  >
                    {s.title}
                  </a>
                </h3>
                <p class="mt-1 max-w-[52rem] text-sign-muted">{s.text}</p>
              </div>
              <span class="flex items-center gap-2 font-bold text-sign-ink max-[599px]:hidden" aria-hidden="true">
                {s.cta}
                <span class="flex size-10 items-center justify-center rounded-full bg-sign-ink text-sign transition-transform duration-300 ease-out group-hover:translate-x-1.5">
                  <Icon name="arrow-right" size={20} />
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="t-codigo" class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
    <div class="wrap grid items-center gap-8 min-[861px]:grid-cols-2">
      <div>
        <SectionHead title="De la ley al código, sin rodeos" id="t-codigo">
          La mayoría de los problemas de accesibilidad se resuelven usando bien HTML. Te enseñamos cómo, con ejemplos que
          funcionan y que puedes probar con el teclado.
        </SectionHead>
        <a href="/componentes/" class="btn btn-ghost">Ver los componentes</a>
      </div>
      <CodeExample code={ejemplo} lang="html" tone="bien" />
    </div>
  </section>

  <section aria-labelledby="t-quien" class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
    <div class="wrap">
      <SectionHead title="Para quién es" id="t-quien" />
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-6">
        {
          perfiles.map((p, i) => (
            <li class:list={[`principio-${[1, 2, 4][i]}`, "revela border-t-4 border-(--c) pt-3"]}>
              <h3 class="text-title">{p.title}</h3>
              <p class="mt-1 text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="t-cierre" class="wrap pb-8">
    <div class="principio-2 revela rounded-[2.25rem_1.5rem_2rem_1.25rem] bg-(--c) p-[clamp(1.5rem,5vw,3.5rem)] text-(--c-ink)">
      <h2 id="t-cierre" class="max-w-[26ch] text-[clamp(1.6rem,1.2rem+1.8vw,2.3rem)]">
        Aunque la ley no te obligue, tu web puede ser para todo el mundo.
      </h2>
      <p class="mt-3 max-w-176 text-[1.08rem]">
        Una de cada seis personas tiene una discapacidad importante, según la{" "}
        <a href="https://www.who.int/es/news-room/fact-sheets/detail/disability-and-health" target="_blank" rel="noopener" class="font-bold text-(--c-ink)"
          >Organización Mundial de la Salud</a
        >. Hacer tu web accesible es decidir que también son tu público.
      </p>
      <a href="/me-afecta/" class="btn mt-6 border-(--c-ink) bg-(--c-ink) text-(--c) hover:-translate-y-0.5 hover:border-sign hover:bg-sign hover:text-sign-ink">Comprobar si me afecta</a>
    </div>
  </section>
</Layout>
